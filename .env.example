# Copia este archivo a .env.local y rellena los valores del proyecto.
# Están en Supabase → Project Settings → API.
#
# Las dos son claves públicas: viajan al navegador a propósito. Lo que se puede
# hacer con ellas lo decide la RLS de la base. La `service_role` NO va aquí ni
# en ningún archivo con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
