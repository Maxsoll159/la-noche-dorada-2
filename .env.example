# Copia este archivo a .env.local y rellena los valores del proyecto.
# Están en Supabase → Project Settings → API.
#
# El navegador nunca habla con Supabase: todo pasa por los route handlers de
# `app/api` (el BFF). Por eso estas variables NO llevan prefijo NEXT_PUBLIC_ y
# no entran en el bundle del cliente. La `service_role` sigue sin usarse.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chat de la mascota (app/api/mascota).
OPENAI_API_KEY=sk-...
